PORT=4000
JWT_SECRET=dev-secret-change-me

# Comma-separated list of allowed CORS origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Persistent storage directory (set on cloud — overrides default data/ and uploads/)
# STORAGE_DIR=/app/storage

